rules_version = '2';

// Règles minimales pour que le tableau se synchronise entre appareils.
// À déployer dans la console Firebase (Firestore Database > Règles) ou via
//   firebase deploy --only firestore:rules
//
// ATTENTION : en l'état, n'importe qui connaissant l'ID du projet peut lire et
// écrire le tableau. C'est acceptable pour un usage interne à faible enjeu ;
// sinon, activez l'authentification et remplacez la condition par
//   allow read, write: if request.auth != null;
service cloud.firestore {
  match /databases/{database}/documents {
    match /board/current {
      allow read, write: if true;
    }
  }
}
