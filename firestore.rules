rules_version = '2';

// Règles minimales pour que les tableaux se synchronisent entre appareils.
// À déployer dans la console Firebase (Firestore Database > Règles) ou via
//   firebase deploy --only firestore:rules
//
// Un document par espace de travail : board/victor, board/alice,
// board/jeyson. board/current est l'ancien document unique, conservé comme
// sauvegarde de la migration vers board/victor — il reste accessible en
// lecture/écriture pour permettre un retour en arrière.
//
// ATTENTION : en l'état, n'importe qui connaissant l'ID du projet peut lire et
// écrire ces tableaux. C'est acceptable pour un usage interne à faible enjeu ;
// sinon, activez l'authentification et remplacez la condition par
//   allow read, write: if request.auth != null;
service cloud.firestore {
  match /databases/{database}/documents {
    match /board/{spaceId} {
      allow read, write: if true;
    }

    // Espace de closing : un document par deal (deals/<id>), plus
    // meta/closingSeed, le marqueur qui empêche l'import du Google Sheet
    // SUIVI DEAL de se rejouer à chaque ouverture.
    match /deals/{dealId} {
      allow read, write: if true;
    }
    match /meta/{docId} {
      allow read, write: if true;
    }
  }
}
